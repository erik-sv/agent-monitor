# Default Discord webhook URL (can be overridden per monitor in monitors/<name>/.env)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook

# Optional: base URL for linking to an external dashboard in Discord embeds.
# Session IDs are appended directly. Leave blank to disable.
# DASHBOARD_BASE_URL=https://yourdash.example.com/?s=

# Optional: override the default triage model (default: claude-sonnet-4-6)
# TRIAGE_MODEL=claude-sonnet-4-6

# Optional: override the default review model for Phase 2 sub-agents
# REVIEW_MODEL=claude-sonnet-4-6
