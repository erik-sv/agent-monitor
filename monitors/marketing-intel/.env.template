# Marketing Intel Monitor - Environment Variables
# Copy this file to .env and fill in the values.
#
# Discord webhook for #marketing-intel channel
DISCORD_WEBHOOK_URL=
DASHBOARD_BASE_URL=https://agentdesk.encypher.com/?s=

# ── AgentDesk Integration ──────────────────────────────────────────────────
# Base URL of AgentDesk instance (no trailing slash)
AGENTDESK_WEBHOOK_URL=https://agentdesk.encypher.com
# Webhook token from AgentDesk monitor registration (POST /api/monitors)
AGENTDESK_WEBHOOK_TOKEN=

# Domain to analyze (default: encypher.com)
MARKETING_INTEL_DOMAIN=encypher.com

# ── Google Analytics 4 ──────────────────────────────────────────────────────
# Property ID in format "properties/XXXXXXXXX"
GA4_PROPERTY_ID=
# Path to service account JSON key file
GA4_CREDENTIALS_PATH=

# ── Google Search Console ───────────────────────────────────────────────────
# Site URL: "sc-domain:encypher.com" (domain property) or "https://www.encypher.com/"
GSC_SITE_URL=
# Path to service account JSON key file (same as GA4 if using one service account)
GSC_CREDENTIALS_PATH=

# ── Zoho SalesIQ ───────────────────────────────────────────────────────────
# Zoho data center: www.zohoapis.com (US), www.zohoapis.eu (EU), etc.
ZOHO_SALESIQ_DOMAIN=www.zohoapis.com
# SalesIQ portal/app ID
ZOHO_SALESIQ_APP_ID=
# OAuth2 access token (scopes: SalesIQ.visitors.READ, SalesIQ.analytics.READ)
ZOHO_SALESIQ_ACCESS_TOKEN=
# Optional: auto-refresh credentials
ZOHO_SALESIQ_REFRESH_TOKEN=
ZOHO_SALESIQ_CLIENT_ID=
ZOHO_SALESIQ_CLIENT_SECRET=
